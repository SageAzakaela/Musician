  "upstreamArchiveSha256": "b041ecb754dba0b3c7495a60c30a70ae3d34b77ca91cc232b118312c9dc2b65a",
  "changes": [
    "Relocated com.sun.media.sound to musician.gervill to avoid JDK module internals.",
    "Excluded fork-added RealTimeSequencer; Musician has its own audio-clock score scheduler.",
    "Removed obsolete ReferenceCountingDevice interface from SoftSynthesizer; explicit stream lifecycle is retained.",
    "Added allocation-free active voice count to SoftSynthesizer.",
    "Fixed SoftChannel allSoundOff to include released voices held by sustain and release tails.",
    "Resolve SF2 sample/loop offsets and root key from combined global/local generators in SF2Instrument; preserves GeneralUser guitar attack trimming.",
    "Fixed ModelStandardIndexedDirector to preserve original performer indices across empty key/velocity intersections; prevents wrong piano, guitar, bass, banjo, violin and drum samples.",
    "Fixed SF2Instrument modulator curve decoding: concave, convex and switch are mutually exclusive encoded values, not independent flags; restores smooth velocity, volume and expression curves."
  ],
